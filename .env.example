# Set these in your hosting provider, or in a private .env.local file for local use.
CMS_ADMIN_TOKEN=
CMS_DATA_DIR=/data
NODE_ENV=production
PORT=3000
SITE_URL=https://nexpixels.com

# PostgreSQL and private S3-compatible object storage.
# DATABASE_URL enables cloud persistence. DIRECT_URL is used by the migration.
DATABASE_URL=
DIRECT_URL=
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET=media
