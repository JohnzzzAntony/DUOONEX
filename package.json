{
  "name": "nexpixels-site-cms",
  "version": "1.0.0",
  "private": true,
  "description": "NexPixels static frontend with a lightweight content management backend",
  "scripts": {
    "dev": "node --watch-path=index.html --watch-path=lib --watch-path=server.js scripts/preview.cjs",
    "start": "node --env-file-if-exists=.env.local server.js",
    "migrate:cloud": "node --env-file-if-exists=.env.local tools/migrate-cloud.cjs",
    "verify:cloud": "node --env-file-if-exists=.env.local tools/verify-cloud.cjs",
    "test": "node --test test/*.test.cjs",
    "test:browser": "node scripts/check-browser.cjs",
    "test:motion": "node scripts/check-motion.cjs",
    "test:podie": "node scripts/check-podie.cjs",
    "verify": "node scripts/verify-site.cjs && node scripts/verify-content.cjs && node scripts/verify-seo.cjs && node scripts/verify-images.cjs && node scripts/verify-podie.cjs",
    "images:build": "node scripts/build-images.cjs && node scripts/build-portfolio-images.cjs && node scripts/register-images.cjs",
    "build": "node scripts/build-frontend.cjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@gsap/react": "^2.1.2",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "animejs": "^4.5.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^0.468.0",
    "motion": "^14.9.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/cli": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "lighthouse": "^13.6.0",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3"
  }
}
