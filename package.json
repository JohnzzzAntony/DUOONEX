{
  "name": "nexpixel-studio-site-cms",
  "version": "1.0.0",
  "private": true,
  "description": "NexPixel Studio static frontend with a lightweight content management backend",
  "scripts": {
    "start": "node --env-file-if-exists=.env.local server.js",
    "migrate:cloud": "node --env-file-if-exists=.env.local tools/migrate-cloud.cjs",
    "verify:cloud": "node --env-file-if-exists=.env.local tools/verify-cloud.cjs",
    "test": "node --test --test-isolation=none test/*.test.js",
    "verify": "node tools/verify.cjs",
    "build": "node tools/build.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "cheerio": "^1.2.0",
    "pg": "^8.23.1"
  }
}
